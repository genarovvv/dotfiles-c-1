// ~/.config/rofi/menu-base.rasi
// Shared base for powermenu.rasi and thememenu.rasi
// Reads the live accent color from ~/.config/rofi/colors.rasi
// (regenerated by ~/.config/bin/set-theme.sh every time you switch theme)

@import "colors.rasi"

configuration {
    show-icons: false;
    hover-select: true;
    me-select-entry: "MousePrimary";
    me-accept-entry: "MouseSecondary|MousePrimary";
}

* {
    font: "JetBrainsMono Nerd Font 22";
}

window {
    background-color: @bg;
    transparency:     "real";
    width:             620px;
    padding:           36px;
    border-radius:     22px;
    location:          center;
    anchor:            center;
}

mainbox {
    children:         [ message, listview ];
    spacing:           26px;
    background-color:  transparent;
}

// the little pill on top ("Uptime: 4 hours" / "Selecciona un tema")
message {
    border-radius:     16px;
    background-color:  @bg-alt;
    padding:           10px 22px;
    horizontal-align:  0.5;
}
textbox {
    text-color:        @muted;
    font:               "JetBrainsMono Nerd Font 10";
    horizontal-align:   0.5;
}

listview {
    columns:            5;
    lines:              1;
    spacing:            14px;
    fixed-height:       true;
    dynamic:            false;
    background-color:   transparent;
    cycle:              true;
}

element {
    orientation:        vertical;
    border-radius:      16px;
    background-color:   @bg-alt;
    text-color:         @fg;
    vertical-align:     0.5;
    horizontal-align:   0.5;
    padding:            0px;
}

element normal.normal {
    background-color:   @bg-alt;
    text-color:         @fg;
}

// row marked with `-a` in the calling script -> highlighted like the
// active/selected square in the screenshot
element normal.active,
element selected.active {
    background-color:   @accent;
    text-color:         @bg;
}

// row marked with `-u` -> alternate accent, used by the theme menu to
// give each theme option its own swatch color
element normal.urgent,
element selected.urgent {
    background-color:   @accent2;
    text-color:         @bg;
}

element selected.normal {
    background-color:   @bg-alt;
    text-color:         @fg;
    border:             2px;
    border-color:       @accent;
}

element-text {
    horizontal-align:   0.5;
    vertical-align:     0.5;
    font:               "JetBrainsMono Nerd Font 26";
}
