@import "colors-launcher.rasi"



configuration {

    modi:                       "drun";

    font:                       "JetBrainsMono Nerd Font 10";

    display-drun:               "";

    drun-display-format:        "{icon}  {name}";

    sidebar-mode:               false;

    show-icons:                 true;



    /* --- esto es lo que faltaba para que filtre bien --- */

    matching:                   "fuzzy";

    sorting-method:             "fzf";

    tokenize:                   true;

    case-sensitive:             false;

    scroll-method:              0;

}



* {

    background-color:           @button;

    text-color:                 @fg;

}



window {

    transparency:               "real";

    width:                      40%;

    border-radius:              12px;

    background-color:           @button;

}



prompt { enabled: false; }



entry {

    placeholder:                "Search";

    placeholder-color:          @fg;

    text-color:                 @fg;

    expand:                     true;

    padding:                    1.5%;

    border-radius:              10px;

    background-color:           @bg;

}



inputbar {

    children:                   [ prompt, entry ];

    background-image:           url("img/bg.png");

    expand:                     false;

    border-radius:              0px 0 12px 12px;

    padding:                    100px 30px 30px 300px;

    background-color:           @button;

}



listview {

    columns:                    1;

    lines:                      4;

    cycle:                      false;

    dynamic:                    true;

    layout:                     vertical;

    padding:                    30px 200px 30px 30px;

    spacing:                    10px;

    background-color:           @button;

}



mainbox {

    children: [ inputbar, listview ];

    background-color:           @button;

}



element {

    orientation:                horizontal;

    padding:                    10px 12px;

    spacing:                    12px;

    border-radius:              10px;

    background-color:           transparent;

    text-color:                 @fg;

}



element-icon {

    size:                       1.4em;

    margin:                     0px 8px 0px 5px;

    background-color:           inherit;

    vertical-align:             0.5;

}



element-text {

    expand:                     true;

    vertical-align:             0.5;

    margin:                     0px;

    background-color:           inherit;

    text-color:                 inherit;

}



element selected {

    background-color:           @bg;

    text-color:                 @fg;

    border-radius:              10px;

}

